{
  "name": "emo-link",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "overrides": {
    "undici": "7.30.1"
  },
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "wrangler dev",
    "test": "node --experimental-transform-types --test 'src/**/*.test.ts'",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p functions --noEmit && tsc -p worker --noEmit",
    "generate-emoji-alphabet": "node ./scripts/generate-emoji-alphabet.mjs",
    "build:local": "NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA next build",
    "types": "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example",
    "types:check": "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example --check",
    "deploy": "npm run build && node scripts/deploy-worker.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@unicode/unicode-17.0.0": "2.1.0",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
